rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and lightly edit their own profile, but the
    // `coins` field is deliberately excluded from every client write
    // path below — it can only change via the Cloud Functions in
    // firebase/functions/index.js, which use the Admin SDK and so
    // bypass these rules entirely. Without this, anyone could set
    // their own balance from the browser console.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.coins == 0;

      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'email', 'phone']);

      // Feasibility Studio — each project is owner-only. Project metadata
      // (name, site details) is simple, non-sensitive data the client can
      // write directly. The conversation is different: only the
      // sendFeasibilityMessage Cloud Function (Admin SDK) may write it,
      // so a user can never fabricate an "assistant" message in their own
      // history or bypass the Practice-tier check by calling Firestore
      // directly from the browser console.
      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /conversation/{doc} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }

        match /files/{fileId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // Coin orders are created and settled entirely by Cloud
    // Functions; the client may only read its own, never write.
    match /coin_orders/{orderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
