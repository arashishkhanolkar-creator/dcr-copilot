rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and lightly edit their own profile, but the
    // `coins` field is deliberately excluded from every client write
    // path below — it can only change via the Cloud Functions in
    // firebase/functions/index.js, which use the Admin SDK and so
    // bypass these rules entirely. Without this, anyone could set
    // their own balance from the browser console.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.coins == 0;

      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'email', 'phone']);
    }

    // Coin orders are created and settled entirely by Cloud
    // Functions; the client may only read its own, never write.
    match /coin_orders/{orderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
